# Beacon local development environment.
# Copy to .env (which is gitignored) and adjust as needed. DO NOT put real
# secrets here or in .env that is shared — this file is an example only.
#
# PostgreSQL is MANDATORY in every environment. SQLite is not supported.
# These defaults match docker-compose.yml, so `docker compose up -d` + this file
# gives a working local setup with no further changes.

# --- Databases (PostgreSQL only) ---------------------------------------------
# Beacon primary database.
DATABASE_URL=postgres://beacon:beacon@localhost:5432/beacon

# Enterprise Platform (aegis) database — a SEPARATE database, isolated from
# `default` by PlatformRouter. Optional for pure Beacon work; REQUIRED to run
# /platform/ and the aegis test suites. This does NOT merge the databases.
PLATFORM_DATABASE_URL=postgres://beacon:beacon@localhost:5432/beacon_platform

# --- Django ------------------------------------------------------------------
DJANGO_DEBUG=True
# Generate your own for anything shared/persistent; this is a throwaway dev value.
DJANGO_SECRET_KEY=dev-only-not-a-real-secret-change-me
PLATFORM_TENANT_CODE=BEACON

# --- Notes for production (Railway) -------------------------------------------
# Set DATABASE_URL to the managed Postgres connection string (add ?sslmode=require
# if connecting over the public network). Set PLATFORM_DATABASE_URL only when the
# platform database has been provisioned. Never commit production values.
