# Beacon product release configuration
# ------------------------------------
# Copy this file to the ROOT of a Beacon product repo as `release.yaml`, then
# fill in the values. The Beacon Release Engine reads this to publish releases.
# The engine NEVER guesses — every value it needs comes from here (or the IPA).

product:
  key: myproduct                 # REQUIRED. Slug → /downloads/<key>/ and releases/<key>/.
                                 #   Lowercase letters, digits, hyphens. e.g. aims, wlj, utmc
  display_name: My Product       # REQUIRED. Branded name (manifest title + portal fallback title).
  name: MyProductApp             # optional. CFBundleName guard — engine aborts if the IPA
                                 #   reports a different CFBundleName.
  bundle_id: com.beaconinnovation.myproduct   # optional but recommended. Guard — engine
                                 #   aborts if the IPA's bundle id differs.

  # --- optional metadata (products become almost configuration-only) ---
  # The engine works fine when these are absent.
  public_name: My Product        # optional. User-facing name shown on the portal
                                 #   (overrides display_name there). Defaults to display_name.
  description: One-line description shown on the release portal.   # optional.
  icon: https://beacon-innovation.com/static/img/myproduct.png     # optional. Icon URL.
  platform: ios                  # optional. ios | android | … (informational; default ios).

source:
  pending_dir: releases/pending  # where you drop the exported IPA (relative to this repo)
  ipa_name: MyProductApp.ipa     # optional. If omitted, the newest *.ipa in pending_dir is used.

beacon:
  repo: /Users/dannyjenkins/Projects/beaconinnovation   # path to the Beacon Innovation repo
                                 #   (the engine + deploy target live there). If the engine is
                                 #   run from that repo, this can be omitted.

deploy:
  base_url: https://beacon-innovation.com   # REQUIRED. Public site origin.
  url_path: /downloads/myproduct # REQUIRED. Canonical public path for this product.
  deploy_branch: main            # branch Railway deploys from (default: main)
  poll_timeout: 900              # seconds to wait for Railway before failing (default: 900)
  legacy_redirects: []           # optional. Old URLs to 301-redirect to the canonical path,
                                 #   e.g. to preserve previously shared links:
                                 #   - /static/downloads/install.html

  # legacy_install: OPTIONAL, TEMPORARY. A public unauthenticated installer page
  #   (install.html + manifest.plist only) for users without Portal access. NOT a
  #   second artifact — its manifest points at the canonical url_path IPA (one IPA,
  #   one SHA-256). To retire: set enabled: false and run /release — the engine
  #   removes the previously-published legacy files automatically (deployment state
  #   always matches config; no manual file/dir deletion).
  # legacy_install:
  #   enabled: true
  #   url_path: /static/downloads        # public path (served by WhiteNoise)
  #   served_dirs:                        # Beacon-repo dir(s) backing url_path
  #     - static/downloads                #   STATICFILES_DIRS source
  #     - staticfiles/downloads           #   STATIC_ROOT (committed, served in prod)

portal:
  show_previous_releases: true   # show the "Previous Releases" table on the portal
